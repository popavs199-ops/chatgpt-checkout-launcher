# Copy this file to .env and fill in your actual Stripe checkout URLs.
# .env is gitignored and will not be committed.

STRIPE_GOPAY_URL=https://buy.stripe.com/your-gopay-link
STRIPE_PAYPAL_URL=https://buy.stripe.com/your-paypal-link
STRIPE_EURO_URL=https://buy.stripe.com/your-euro-link
STRIPE_UK_URL=https://buy.stripe.com/your-uk-link
